{
  "name": "@cborg/mcp-host",
  "version": "0.1.0",
  "description": "MCP server + Native Messaging host + CLI for chrome-bookmark-organizer",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "cborg-mcp-host": "./bin/mcp-host.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "require": "./dist/cli/index.cjs"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cborg/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^14.0.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.3",
    "typescript": "~5.6.3",
    "vitest": "^2.1.9"
  }
}
